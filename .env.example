# Local development; set NODE_ENV=production in Render.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_BASE_PATH=/contracts-zar
API_URL=http://localhost:5000

# MongoDB Atlas database URI. For production, use a dedicated production database.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/contracts-zar?retryWrites=true&w=majority

# Generate distinct random JWT secrets of at least 64 characters for production.
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-64-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
SIGNING_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Generate independent 32-byte hexadecimal keys.
ID_ENCRYPTION_KEY=replace-with-64-hex-characters
ID_HASH_PEPPER=replace-with-64-hex-characters

# Configure an email provider before production deployment.
EMAIL_PROVIDER=resend
EMAIL_FROM="Contracts ZAR <no-reply@yourdomain.co.za>"
RESEND_API_KEY=
BREVO_API_KEY=

# Used once by npm run seed:admin; do not retain ADMIN_PASSWORD in production.
ADMIN_EMAIL=wmaseko1@gmail.com
ADMIN_PASSWORD=replace-before-running-seed-admin
ADMIN_FIRST_NAME=Wandile
ADMIN_LAST_NAME=Maseko
ADMIN_ID_NUMBER=001
